#!/bin/bash

# omarchy:summary=Returns true if every named package could actually be installed on this host (false for skip-mapped or unknown entries).
# omarchy:args=<packages...>

# Fedora dispatch — see omedora/architecture.md §3. Arch path below is unchanged.
case "${OMARCHY_DISTRO:-$(omarchy-distro 2>/dev/null || echo arch)}" in
  fedora) exec "$(dirname -- "${BASH_SOURCE[0]}")/fedora/pkg.py" installable "$@" ;;
  fedora-ostree) exec "$(dirname -- "${BASH_SOURCE[0]}")/omarchy-ostree/pkg.py" installable "$@" ;;
esac

# Arch: the map this asks about is Fedora's, so nothing here is a reason to hide
# a row. A name the repos do not carry is one upstream expects from the AUR, and
# the row's own installer is what fails if no helper is there to fetch it — the
# same answer the menu gave before this predicate existed.
exit 0
