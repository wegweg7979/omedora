#!/bin/bash

# omarchy:summary=Apply the current theme to GNOME color mode and icon settings
# omarchy:hidden=true

# gsettings needs a user DBus session. During ISO installs this command can be
# reached from arch-chroot while applying the initial Omarchy theme; defer until
# the user has a real session instead of emitting dconf warnings.
if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
  exit 0
fi

THEME_DIR=$HOME/.local/state/omarchy/current/theme
COLORS_FILE="$THEME_DIR/colors.toml"

# omarchy-theme-color resolves mode from colors.toml (`mode = "light"`), a
# legacy light.mode marker beside it, or background luminance for user themes.
mode=$(omarchy-theme-color --file "$COLORS_FILE" mode)

# GTK reads its theme from its own settings file when no XSETTINGS daemon is
# running — a bare Hyprland session runs none — and no dconf schema carries the
# prefer-dark flag (gtk3/gtk4 ship no settings schema for it). Rewrite ONLY the
# keys named here: a user's font, cursor and icon keys must survive a theme set.
set_gtk_setting() { # $1 = 3.0|4.0   $2 = key   $3 = value
  local file="$HOME/.config/gtk-$1/settings.ini" key=$2 value=$3
  mkdir -p "${file%/*}"
  if [[ ! -f $file ]]; then
    printf '[Settings]\n' >"$file"
  elif ! grep -q '^\[Settings\]' "$file"; then
    { printf '[Settings]\n'; cat "$file"; } >"$file.tmp" && mv "$file.tmp" "$file"
  fi
  if grep -q "^${key}=" "$file"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$file"
  else
    sed -i "/^\[Settings\]/a ${key}=${value}" "$file"
  fi
}

theme_installed() { # $1 = theme name; GTK's own search order: XDG_DATA_HOME then XDG_DATA_DIRS
  # Split on ':' explicitly: word splitting never touches a colon, so an
  # unquoted ${XDG_DATA_DIRS} stays ONE word and every entry after the first is
  # invisible ("/usr/local/share:/usr/share/themes/…" is not a directory).
  local dir
  local -a dirs
  IFS=: read -ra dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for dir in "${dirs[@]}"; do
    [[ -d $dir/themes/$1 ]] && return 0
  done
  return 1
}

if [[ $mode == "light" ]]; then
  gsettings set org.gnome.desktop.interface color-scheme "prefer-light"
  gsettings set org.gnome.desktop.interface gtk-theme "Adwaita"
else
  gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
  # Fedora: "Adwaita-dark" is not a theme NAME GTK 3.24 can resolve — it derives
  # the dark variant itself, looks for "Adwaita-dark-dark", misses, and silently
  # renders LIGHT Adwaita. Every GTK3 window then looked light (dialogs, file
  # choosers, anything painted through xdg-desktop-portal-gtk) while
  # GTK4/libadwaita apps stayed dark off color-scheme, which is what reads as
  # "only some dialogs are light". Fedora names the sheet GTK3 can resolve
  # instead: adw-gtk3-theme is the libadwaita look ported to GTK 3, with plain
  # Adwaita as the fallback wherever it is not installed (mutable Fedora, an
  # older image). adw-gtk3 ships gtk-3.0 files only, so GTK4 keeps Adwaita and
  # follows color-scheme regardless. Arch keeps upstream's line verbatim (the
  # relocation is allowlisted in test/byte-identity-test.sh).
  if [[ $(omarchy-distro) == arch ]]; then
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"
    gtk_theme_name=Adwaita-dark
  elif theme_installed adw-gtk3-dark; then
    gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3-dark"
    gtk_theme_name=adw-gtk3-dark
  else
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita"
    gtk_theme_name=Adwaita
  fi
fi

# Fedora: mirror the same choice into the GTK settings files GTK reads when no
# XSETTINGS daemon is running. dconf's gtk-theme is what both toolkits actually
# resolve for the NAME (it overrides this file — measured for GTK3 and GTK4),
# while the prefer-dark FLAG exists only here; both are written so the file
# describes the same state. adw-gtk3 ships a gtk-4.0 sheet as well as gtk-3.0, so
# the same name serves both; a theme without one falls back to Adwaita and
# follows color-scheme. Arch is untouched: gnome-settings-daemon and the
# XSETTINGS route cover it there.
if [[ $(omarchy-distro) != arch ]]; then
  prefer_dark=1
  [[ $mode == "light" ]] && prefer_dark=0
  set_gtk_setting 3.0 gtk-theme-name "${gtk_theme_name:-Adwaita}"
  set_gtk_setting 3.0 gtk-application-prefer-dark-theme "$prefer_dark"
  set_gtk_setting 4.0 gtk-theme-name "${gtk_theme_name:-Adwaita}"
  set_gtk_setting 4.0 gtk-application-prefer-dark-theme "$prefer_dark"
fi

# Change gnome icon theme color
GNOME_ICONS_THEME=$HOME/.local/state/omarchy/current/theme/icons.theme
if [[ -f $GNOME_ICONS_THEME ]]; then
  gsettings set org.gnome.desktop.interface icon-theme "$(<$GNOME_ICONS_THEME)"
else
  gsettings set org.gnome.desktop.interface icon-theme "Yaru-blue"
fi
