#!/bin/bash
#
# Immutable (bootc/ostree) sibling of bin/omarchy-update-available (exec'd by
# its fedora-ostree dispatch). Same contract as upstream so the shell update
# widget works unchanged:
#   - writes  ~/.local/state/omarchy/updates/{packages,aur,available,checked-at}
#     (+ error on failure, removed on success)
#   - exit 0  -> updates available, stdout is the list
#   - exit !0 -> up to date ("System is up to date" on stdout)
#
# On an immutable host "is there an update?" means "is there a newer container
# image than the deployed one?" — NOT `dnf check-upgrade` (the RPMs are baked
# into the image; there is no live RPM DB to diff against an upgrade).
#
# Detection strategy (mirrors how the OS itself stages updates):
#   1. STAGED: if rpm-ostreed.automatic stages a newer image, the newest
#      deployment's timestamp is newer than the booted one -> update available
#      (pending a reboot to apply).
#   2. NETWORK (when auto-stage is off): compare the remote registry digest
#      (skopeo) against the booted deployment's real image digest.
#
# Seams for tests:
#   OMEDORA_OSTREE_JSON   path to `rpm-ostree status --json` output fixture
#   OMEDORA_DEPLOYED_TS   the booted deployment's timestamp (fallback read)
#   OMEDORA_IMAGE_REF     image ref used for the skopeo digest check
#   OMEDORA_SKOPEO_CMD    the remote-digest driver (default "skopeo inspect")

set -euo pipefail

CHECK_TIMEOUT="${OMARCHY_UPDATE_CHECK_TIMEOUT:-60}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/updates"

mkdir -p "$STATE_DIR"

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/ostree-update-available.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT
packages_tmp="$tmp_dir/packages"
errors_tmp="$tmp_dir/errors"
: >"$packages_tmp"
: >"$errors_tmp"

# --- resolve the deployed image ref + booted digest ---------------------------
json=""
if [[ ${OMEDORA_OSTREE_JSON+x} == x ]]; then
  [[ -f $OMEDORA_OSTREE_JSON ]] && json=$(<"$OMEDORA_OSTREE_JSON")
else
  json=$(rpm-ostree status --json 2>/dev/null || true)
fi

booted_digest=""
image_ref=""
if [[ -n $json ]]; then
  booted_digest=$(printf '%s' "$json" | jq -r \
    '.deployments[] | select(.booted==true) | ."container-image-reference-digest" // empty' 2>/dev/null | head -1)
  raw_ref=$(printf '%s' "$json" | jq -r \
    '.deployments[] | select(.booted==true) | ."container-image-reference" // empty' 2>/dev/null | head -1)
  # container-image-reference is already "ostree-image-signed:docker://<ref>";
  # strip everything up to docker:// then add one back for skopeo.
  [[ -n $raw_ref ]] && image_ref="docker://${raw_ref#*docker://}"
fi

echo "ostree-update-available: booted_digest=${booted_digest:-?} image_ref=${image_ref:-?}" >&2

# --- 1. staged deployment detect -------------------------------------------------
# rpm-ostreed.automatic stages a newer image as a non-booted deployment with a
# newer timestamp. Compare the newest deployment's timestamp to the booted one
# (NEVER count non-booted deployments — a rollback sibling is also non-booted).
newest_ts=$(printf '%s' "$json" | jq -r '.deployments | max_by(.timestamp) | .timestamp // empty' 2>/dev/null)
booted_ts=$(printf '%s' "$json" | jq -r '.deployments[] | select(.booted==true) | .timestamp // empty' 2>/dev/null | head -1)
staged_available=0
if [[ -n $newest_ts && -n $booted_ts && $newest_ts > $booted_ts ]]; then
  staged_available=1
fi

# --- 2. remote digest detect (network poll fallback) -----------------------------
remote_available=0
if [[ $staged_available == 0 && -n $image_ref ]]; then
  skopeo_cmd="${OMEDORA_SKOPEO_CMD:-skopeo inspect --format '{{.Digest}}'}"
  read -r -a skopeo <<<"$skopeo_cmd"
  remote=$(timeout "$CHECK_TIMEOUT" "${skopeo[@]}" "$image_ref" 2>/dev/null || true)
  echo "ostree-update-available: remote=${remote:-?}" >&2
  if [[ -n $remote && -n $booted_digest && $remote != "$booted_digest" ]]; then
    remote_available=1
  fi
fi

# --- write state + exit per the widget contract -----------------------------------
if (( staged_available || remote_available )); then
  # A placeholder package line so the bar badge has a list to show.
  echo "omarchy-ostree-image" >"$packages_tmp"
  cp "$packages_tmp" "$STATE_DIR/packages"
  : >"$STATE_DIR/aur"
  cp "$packages_tmp" "$STATE_DIR/available"
  date --iso-8601=seconds >"$STATE_DIR/checked-at"
  rm -f "$STATE_DIR/error"
  cat "$STATE_DIR/available"
  echo "Omedora image update available${staged_available:+ (staged — reboot to apply)}" >&2
  exit 0
fi

# up to date
: >"$STATE_DIR/packages"
: >"$STATE_DIR/aur"
: >"$STATE_DIR/available"
date --iso-8601=seconds >"$STATE_DIR/checked-at"
rm -f "$STATE_DIR/error"
echo "System is up to date"
exit 1
